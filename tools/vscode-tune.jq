    "terminal.foreground": "#eee8dc",
    "terminalCursor.foreground": "#f3a712",
    "terminal.selectionBackground": "#174d3a",

    "statusBar.background": "#174d3a",
    "statusBar.foreground": "#eee8dc",
    "statusBar.border": "#174d3a",
    "statusBar.noFolderBackground": "#0d2f25",
    "statusBar.noFolderForeground": "#eee8dc",
    "statusBar.debuggingBackground": "#f3a712",
