# Bench Grid VS Code tuning, applied over Omarchy's generated vscode-theme.json.
# 1. Every amber (#f3a712..) becomes a muted-green wash with the same alpha.
# 2. Amber is restored only where something is focused, active or changed.
# 3. Workbench surfaces get the desk layout: mat status bar, graphite editor.
#
# Usage: jq -f tools/vscode-tune.jq base.json > vscode-theme.json

def amber_keys: [
  "focusBorder", "list.focusOutline", "statusBar.focusBorder", "statusBarItem.focusBorder",
  "inlineChatInput.focusBorder", "notebook.focusedCellBorder", "notebook.focusedEditorBorder",
  "tab.activeBorderTop", "activityBar.activeBorder", "panelTitle.activeBorder", "terminal.tab.activeBorder",
  "badge.background", "activityBarBadge.background", "progressBar.background",
  "settings.modifiedItemIndicator", "editorCursor.foreground", "terminalCursor.foreground",
  "editorGutter.modifiedBackground", "gitDecoration.modifiedResourceForeground",
  "notebookStatusRunningIcon.foreground", "ports.iconRunningProcessForeground"
];

.name = "Bench Grid"
| .colors |= with_entries(
    if (.value | type) == "string" and (.value | test("^#f3a712"; "i")) and ((.key as $k | amber_keys | index($k)) | not)
    then .value |= sub("^#f3a712"; "#a8c7b7"; "i")
    else . end)
| .colors += {
    "focusBorder": "#f3a712",
    "selection.background": "#174d3a",

    "titleBar.activeBackground": "#111814",
    "titleBar.activeForeground": "#eee8dc",
    "titleBar.inactiveBackground": "#111814",
    "titleBar.inactiveForeground": "#6f857a",
    "titleBar.border": "#26362f",
    "commandCenter.background": "#17201c",
    "commandCenter.border": "#26362f",
    "commandCenter.activeBorder": "#42584d",

    "activityBar.background": "#111814",
    "activityBar.border": "#26362f",
    "activityBar.foreground": "#eee8dc",
    "activityBar.inactiveForeground": "#6f857a",
    "activityBar.activeBackground": "#17201c",
    "activityBarBadge.foreground": "#17201c",
    "badge.foreground": "#17201c",

    "sideBar.background": "#131b17",
    "sideBar.border": "#26362f",
    "sideBarSectionHeader.background": "#131b17",
    "sideBarSectionHeader.border": "#26362f",
    "sideBarTitle.foreground": "#a8c7b7",

    "editor.background": "#17201c",
    "editor.foreground": "#eee8dc",
    "editor.lineHighlightBackground": "#1e2a25",
    "editor.lineHighlightBorder": "#00000000",
    "editor.selectionBackground": "#174d3a",
    "editor.inactiveSelectionBackground": "#174d3a80",
    "editor.findMatchBackground": "#f3a71255",
    "editor.findMatchBorder": "#f3a712",
    "editor.findMatchHighlightBackground": "#d8b26a30",
    "editorCursor.foreground": "#f3a712",
    "editorLineNumber.foreground": "#42584d",
    "editorLineNumber.activeForeground": "#a8c7b7",
    "editorIndentGuide.background1": "#26362f",
    "editorIndentGuide.activeBackground1": "#42584d",
    "editorRuler.foreground": "#26362f",
    "editorWhitespace.foreground": "#2e4038",
    "editorBracketMatch.background": "#174d3a",
    "editorBracketMatch.border": "#a8c7b7",
    "editorGroup.border": "#26362f",
    "editorGroupHeader.tabsBackground": "#111814",
    "editorGroupHeader.tabsBorder": "#26362f",
    "editorWidget.background": "#1e2a25",
    "editorWidget.border": "#42584d",
    "editorSuggestWidget.background": "#1e2a25",
    "editorSuggestWidget.border": "#42584d",
    "editorSuggestWidget.selectedBackground": "#174d3a",
    "editorSuggestWidget.highlightForeground": "#d8b26a",
    "editorSuggestWidget.focusHighlightForeground": "#e6c78b",
    "editorHoverWidget.background": "#1e2a25",
    "editorHoverWidget.border": "#42584d",
    "editorGutter.modifiedBackground": "#f3a712",
    "editorGutter.addedBackground": "#86b896",
    "editorGutter.deletedBackground": "#e07a5f",

    "tab.activeBackground": "#17201c",
    "tab.activeForeground": "#eee8dc",
    "tab.inactiveBackground": "#111814",
    "tab.inactiveForeground": "#6f857a",
    "tab.border": "#111814",
    "tab.activeBorder": "#17201c",
    "tab.activeBorderTop": "#f3a712",
    "tab.unfocusedActiveBorderTop": "#42584d",
    "tab.unfocusedActiveForeground": "#a8c7b7",
