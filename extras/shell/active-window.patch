@@ -12,9 +12,20 @@
 
   readonly property var toplevel: ToplevelManager.activeToplevel
   readonly property string title: toplevel ? (toplevel.title || toplevel.appId || "") : ""
+  // Bench Grid: the bar shows the program's name, not the window title (that stays in the tooltip).
+  // The name comes from the app's desktop entry (foot -> Foot, org.gnome.Nautilus -> Files); without
+  // one, the last part of the app id, capitalised.
+  readonly property string appId: toplevel ? (toplevel.appId || "") : ""
+  readonly property string appName: {
+    if (appId === "") return title
+    var entry = DesktopEntries.heuristicLookup(appId)
+    if (entry && entry.name) return entry.name
+    var part = appId.split(".").pop()
+    return part.charAt(0).toUpperCase() + part.slice(1)
+  }
   readonly property int maxLabelWidth: Number(setting("maxWidth", 280))
 
-  visible: title !== "" && !vertical
