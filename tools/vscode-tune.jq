    "gitDecoration.modifiedResourceForeground": "#f3a712",
    "gitDecoration.untrackedResourceForeground": "#86b896",
    "gitDecoration.addedResourceForeground": "#86b896",
    "gitDecoration.deletedResourceForeground": "#e07a5f",
    "gitDecoration.ignoredResourceForeground": "#6f857a",
    "gitDecoration.conflictingResourceForeground": "#c49aae",

    "peekView.border": "#42584d",
